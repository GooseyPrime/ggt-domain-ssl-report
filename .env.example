# Shop origin for checkout + payment verify (no Stripe secrets in this repo)
NEXT_PUBLIC_SHOP_ORIGIN=https://goldengoosetools.com

# Display price for this tool — source of truth is shop config.
# If unset, UI shows "from shop" (never hardcode a dollar amount as truth).
NEXT_PUBLIC_GGT_PRICE=

# Optional SKU / product key the shop expects when starting checkout
NEXT_PUBLIC_GGT_SKU=domain-ssl-report

# Local stub only: set to "1" to treat requests as paid without shop verify.
# Documented placeholder — production must call shop verify.
# GGT_PAID_STUB=1

# Comma-separated shop sale-desk allowlist mirror (SALE_PRODUCT_IDS).
# Checkout stays gated until this list includes domain-ssl-report.
# NEXT_PUBLIC_SHOP_SALE_PRODUCTS=seo-audit,accessibility
